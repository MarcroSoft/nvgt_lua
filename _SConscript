# Build script for the lua plugin. The vendored Lua 5.5 sources in lua55 are compiled directly into the plugin through
# the lua55.cpp amalgamation (as C++, so lua errors unwind with exceptions), so no external dependency is needed.
Import("env")

sources = ["lua.cpp", "nvgt_lua_bridge.cpp", "lua55.cpp"]

# iOS has no system(); lua's loslib only knows that when LUA_USE_IOS is defined (see lua55/loslib.c), which also
# turns on full POSIX mode via luaconf.h. Without it, lua55.cpp fails to compile against the iphoneos SDK.
if env["NVGT_TARGET"] == "ios":
	env = env.Clone()
	env.Append(CPPDEFINES = ["LUA_USE_IOS"])

# iOS distribution cannot load shared library plugins; only the static lib is useful there.
if ARGUMENTS.get("no_shared_plugins", "0") == "0" and env["NVGT_TARGET"] != "ios":
	# The shared plugin is compiled for size; the reflection bridge dispatches through script contexts anyway so raw
	# interpreter speed is rarely the bottleneck, and a small dll matters more for game distribution.
	size_env = env.Clone()
	if size_env["NVGT_TARGET"] == "windows":
		size_env["CCFLAGS"] = [f for f in size_env["CCFLAGS"] if f != "/O2"] + ["/O1", "/GL", "/Gw"]
		size_env.Append(LINKFLAGS = ["/LTCG"])
	else:
		size_env["CXXFLAGS"] = [f for f in size_env["CXXFLAGS"] if f != "-O3"] + ["-Os", "-fvisibility=hidden", "-fvisibility-inlines-hidden", "-ffunction-sections", "-fdata-sections"]
		if size_env["NVGT_TARGET"] in ("linux", "android"):
			size_env.Append(LINKFLAGS = ["-Wl,--gc-sections"])
		elif size_env["NVGT_TARGET"] == "macos":
			size_env.Append(LINKFLAGS = ["-Wl,-dead_strip"])
	shared_objects = [size_env.SharedObject(s[:-4] + "_shared", s) for s in sources]
	size_env.SharedLibrary(env["PLUGIN_DEST_DIR"] + "/lua", shared_objects, LIBS = env["LIBS"])

static_defines = list(env["CPPDEFINES"]) + [("NVGT_PLUGIN_STATIC", "lua")]
static_objects = [env.Object(s[:-4] + "_static", s, CPPDEFINES = static_defines) for s in sources]
static = env.StaticLibrary("#build/lib/lua", static_objects)
Return("static")
